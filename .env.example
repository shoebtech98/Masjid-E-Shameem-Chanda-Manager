# ============================================================
# Masjid E Shameem – Chanda Manager · Environment configuration
# ============================================================
# Copy this file to `.env` and adjust for your deployment.
# The app reads .env automatically at startup (Node's built-in loader).
# All variables are optional — sensible defaults are shown.

# --- Runtime mode ----------------------------------------------------------
# Set to "production" on a real deployment. This enables:
#   * Secure (HTTPS-only) session cookies
#   * trust-proxy (reverse-proxy TLS termination)
#   * demo-account and sample-data gates below
# Leave unset / "development" for local work.
NODE_ENV=production

# --- Server -----------------------------------------------------------------
# Port the Node process listens on (default 3000). Behind a reverse proxy the
# proxy forwards to this port.
PORT=3000

# --- Database ---------------------------------------------------------------
# Absolute path to the SQLite database file. MUST point to persistent storage
# (a directory that survives restarts and deploys). Default is
# ./data/chanda.db relative to the project.
# DB_PATH=/var/lib/masjid-shameem/chanda.db

# --- Cookies -----------------------------------------------------------------
# The session cookie is httpOnly + SameSite=Lax always, and Secure in
# production. Set COOKIE_SECURE explicitly only if you must override
# (e.g. 1 when TLS is terminated elsewhere, or 0 for a local LAN install
# without HTTPS).
# COOKIE_SECURE=1

# --- Initial Admin (production first-run) ------------------------------------
# Demo credentials are NEVER created in production. On a brand-new empty
# database, set these two variables ONCE to create the first real Admin
# account automatically, then REMOVE them (and change the password in
# Settings). Alternatively create it manually after starting the server:
#   npm run create-user -- --name "Admin Name" --email admin@example.org --role admin
# INITIAL_ADMIN_EMAIL=admin@example.org
# INITIAL_ADMIN_PASSWORD=change-me-now

# --- Bootstrap / demo data ---------------------------------------------------
# Development-only convenience; in production these are explicit testing
# opt-ins and should never be enabled on a database with real records.
# SEED_DEMO_USERS=1
# SEED_SAMPLE_DATA=1

# --- Demo-only actions --------------------------------------------------------
# The "Reset Sample Data" admin action wipes real financial records, so it is
# disabled in production and the server rejects it even if called
# directly. Enable it ONLY for an explicit demo/test installation:
#   DEMO_MODE=true   -> reset allowed outside production only
#   DEMO_MODE=false  -> reset disabled everywhere (even local development)
# DEMO_MODE=true
